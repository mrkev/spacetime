+// MapKit selects its points of interest (see selectableMapFeatures) only through these iOS 16
+// methods, not the ones for annotation views. Implementing them might stop MapKit from calling the
+// view methods for markers, so markers are passed on to those; handling one twice is harmless.
+- (void)mapView:(AIRMap *)mapView didSelectAnnotation:(id<MKAnnotation>)annotation
+{
+    if ([self reportPoi:annotation onMap:mapView selected:YES]) return;
+    MKAnnotationView *view = [mapView viewForAnnotation:annotation];
+    if (view) [self mapView:mapView didSelectAnnotationView:view];
+}
+
+- (void)mapView:(AIRMap *)mapView didDeselectAnnotation:(id<MKAnnotation>)annotation
+{
+    if ([self reportPoi:annotation onMap:mapView selected:NO]) return;
+    MKAnnotationView *view = [mapView viewForAnnotation:annotation];
+    if (view) [self mapView:mapView didDeselectAnnotationView:view];
+}
+
+// Saves a point of interest's icon (MapKit's glyph for it) under Documents/place-icons, named by its
+// contents so each icon is saved once, and returns its path relative to Documents.
+static NSString *savePoiIcon(UIImage *image)
+{
+    NSData *png = image ? UIImagePNGRepresentation(image) : nil;
+    if (!png) return @"";
+    unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+    CC_SHA256(png.bytes, (CC_LONG)png.length, digest);
+    NSMutableString *name = [NSMutableString string];
+    for (int i = 0; i < 8; i++) [name appendFormat:@"%02x", digest[i]];
+    // The scale suffix lets UIImage load it at the right size.
+    NSString *relative = [NSString stringWithFormat:@"place-icons/%@@%dx.png", name, (int)image.scale];
+    NSURL *documents = [NSFileManager.defaultManager URLsForDirectory:NSDocumentDirectory
+                                                            inDomains:NSUserDomainMask].firstObject;
+    NSURL *url = [documents URLByAppendingPathComponent:relative];
+    if (![NSFileManager.defaultManager fileExistsAtPath:url.path]) {
+        [NSFileManager.defaultManager createDirectoryAtURL:url.URLByDeletingLastPathComponent
+                               withIntermediateDirectories:YES attributes:nil error:nil];
+        if (![png writeToURL:url atomically:YES]) return @"";
+    }
+    return relative;
+}
+
+// Reports a point of interest being selected or deselected through onPoiClick, with its category
+// and icon. Deselecting sends placeId "deselect". Returns whether it was one.
+- (BOOL)reportPoi:(id<MKAnnotation>)annotation onMap:(AIRMap *)mapView selected:(BOOL)selected
+{
+    if (@available(iOS 16.0, *)) {
+        if (![annotation isKindOfClass:[MKMapFeatureAnnotation class]]) return NO;
+        if (!mapView.onPoiClick) return YES;
+        MKMapFeatureAnnotation *feature = (MKMapFeatureAnnotation *)annotation;
+        CLLocationCoordinate2D coordinate = annotation.coordinate;
+        CGPoint point = [mapView convertCoordinate:coordinate toPointToView:mapView];
+        mapView.onPoiClick(@{
+            @"placeId": selected ? @"" : @"deselect",
+            @"name": annotation.title ?: @"",
+            @"category": feature.pointOfInterestCategory ?: @"",
+            @"icon": selected ? savePoiIcon(feature.iconStyle.image) : @"",
+            @"coordinate": @{
+                @"latitude": @(coordinate.latitude),
+                @"longitude": @(coordinate.longitude),
+            },
+            @"position": @{
+                @"x": @(point.x),
+                @"y": @(point.y),
+            },
+        });
+        return YES;
+    }
+    return NO;
+}
