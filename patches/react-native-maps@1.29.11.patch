+// "symbol:<SF Symbol name>" or "image:<path under Documents>"; nil shows MapKit's default.
+- (UIImage *)glyphImage
+{
+    if ([_glyph hasPrefix:@"symbol:"]) {
+        return [UIImage systemImageNamed:[_glyph substringFromIndex:7]];
+    }
+    if ([_glyph hasPrefix:@"image:"]) {
+        NSURL *documents = [NSFileManager.defaultManager URLsForDirectory:NSDocumentDirectory
+                                                                inDomains:NSUserDomainMask].firstObject;
+        NSURL *url = [documents URLByAppendingPathComponent:[_glyph substringFromIndex:6]];
+        return [UIImage imageWithContentsOfFile:url.path];
+    }
+    return nil;
+}
