{
  "expo": {
    "name": "Spacetime",
    "slug": "spacetime",
    "scheme": "spacetime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spacetime.app"
    },
    "android": {
      "package": "com.spacetime.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Spacetime shows your calendar events in the Time tab.",
          "remindersPermission": "Spacetime shows your reminders alongside your calendar."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Spacetime shows where you are on the map.",
          "locationAlwaysAndWhenInUsePermission": "Spacetime uses your location in the background to remind you when you arrive at or leave a saved place.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
