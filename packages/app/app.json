{
  "expo": {
    "name": "Spacetime",
    "slug": "spacetime",
    "scheme": "spacetime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/spacetime.icon",
      "bundleIdentifier": "com.mrkev.spacetime",
      "appleTeamId": "J8ZU83TC57"
    },
    "android": {
      "package": "com.mrkev.spacetime",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Spacetime shows your calendar events in the Time tab.",
          "remindersPermission": "Spacetime shows your reminders alongside your calendar."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Spacetime shows where you are on the map."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
